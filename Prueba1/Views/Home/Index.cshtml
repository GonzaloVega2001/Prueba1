<!-- ========================================================= -->
<!-- SERVICIOS -->
<!-- ========================================================= -->

<section id="servicios">

    <div class="wrap">

        <div class="section-head reveal">

            <div>

                <span class="section-tag">
                    Servicios
                </span>

                <h2>
                    Tres formas de trabajar juntos
                </h2>

            </div>

            <p class="section-desc">
                Elige según qué tan definido esté tu proyecto —
                desde una idea en servilleta hasta un sistema que
                ya funciona y necesita crecer.
            </p>

        </div>


        <div class="services reveal">

            @foreach (var s in Model.Services)
            {
                <div class="service-card">

                    <span class="service-num">
                        @s.Num
                    </span>

                    <h3>
                        @s.Title
                    </h3>

                    <p>
                        @s.Desc
                    </p>

                    <div class="service-tags">

                        @foreach (var tag in s.Tags)
                        {
                            <span class="tag">
                                @tag
                            </span>
                        }

                    </div>

                </div>
            }

        </div>

    </div>

</section>


<!-- ========================================================= -->
<!-- PROCESO -->
<!-- ========================================================= -->

<section id="proceso">

    <div class="wrap">

        <div class="section-head reveal">

            <div>

                <span class="section-tag">
                    Proceso
                </span>

                <h2>
                    Cómo avanza un proyecto
                </h2>

            </div>

            <p class="section-desc">
                Cuatro etapas, siempre en este orden —
                sin saltarse la parte de entender el problema
                antes de escribir código.
            </p>

        </div>


        <div class="reveal">

            @foreach (var step in Model.Process)
            {
                <div class="process-row">

                    <span class="process-num">
                        @step.Num
                    </span>

                    <h3>
                        @step.Title
                    </h3>

                    <p>
                        @step.Desc
                    </p>

                </div>
            }

        </div>

    </div>

</section>


<!-- ========================================================= -->
<!-- STACK -->
<!-- ========================================================= -->

<section id="stack">

    <div class="wrap">

        <div class="section-head reveal">

            <div>

                <span class="section-tag">
                    Stack técnico
                </span>

                <h2>
                    Con qué construimos
                </h2>

            </div>

            <p class="section-desc">
                Herramientas elegidas por proyecto, no por moda —
                priorizando lo que sea más fácil de operar
                a largo plazo.
            </p>

        </div>


        <div class="stack-groups reveal">

            @foreach (var group in Model.Stack)
            {
                <div class="stack-group">

                    <h4>
                        @group.Group
                    </h4>

                    <ul>

                        @foreach (var item in group.Items)
                        {
                            <li>
                                @item
                            </li>
                        }

                    </ul>

                </div>
            }

        </div>

    </div>

</section>


<!-- ========================================================= -->
<!-- POR QUÉ NOSOTROS -->
<!-- ========================================================= -->

<section>

    <div class="wrap">

        <div class="section-head reveal">

            <div>

                <span class="section-tag">
                    Por qué trabajar con nosotros
                </span>

                <h2>
                    Sin equipo de ventas, sin capas de más
                </h2>

            </div>

        </div>


        <div class="why reveal">

            @foreach (var item in Model.Why)
            {
                <div class="why-card">

                    <b>
                        @item.Title
                    </b>

                    <p>
                        @item.Desc
                    </p>

                </div>
            }

        </div>

    </div>

</section>


<!-- ========================================================= -->
<!-- CONTACTO -->
<!-- ========================================================= -->

<section id="contacto"
         style="border-bottom:none;">

    <div class="wrap contact-grid">

        <!-- INFORMACIÓN -->

        <div class="contact-info reveal">

            <span class="section-tag">
                Contacto
            </span>

            <h2>
                Hablemos de tu proyecto
            </h2>

            <p>
                Cuéntanos qué necesitas y te respondemos
                con una propuesta inicial en 48 horas hábiles.
                Sin compromiso.
            </p>

            @foreach (var line in Model.ContactLines)
            {
                <div class="contact-line">

                    <span>
                        @line.Label
                    </span>

                    <span>
                        @line.Value
                    </span>

                </div>
            }

        </div>


        <!-- FORMULARIO -->

        <form asp-controller="Home"
              asp-action="Contact"
              method="post"
              class="reveal">

            @Html.AntiForgeryToken()


            <!-- NOMBRE / CORREO -->

            <div class="row2">

                <div class="field">

                    <label asp-for="ContactForm.Name">
                        Nombre
                    </label>

                    <input asp-for="ContactForm.Name"
                           placeholder="Tu nombre" />

                    <span asp-validation-for="ContactForm.Name"
                          style="
                        color:#B3261E;
                        font-family:var(--mono);
                        font-size:12px;
                        ">
                    </span>

                </div>


                <div class="field">

                    <label asp-for="ContactForm.Email">
                        Correo
                    </label>

                    <input asp-for="ContactForm.Email"
                           placeholder="tucorreo@empresa.cl" />

                    <span asp-validation-for="ContactForm.Email"
                          style="
                        color:#B3261E;
                        font-family:var(--mono);
                        font-size:12px;
                        ">
                    </span>

                </div>

            </div>


            <!-- TIPO DE PROYECTO -->

            <div class="field">

                <label asp-for="ContactForm.ProjectType">
                    Tipo de proyecto
                </label>

                <select asp-for="ContactForm.ProjectType"
                        asp-items="@(new SelectList(ContactFormModel.ProjectTypes))">
                </select>

            </div>


            <!-- MENSAJE -->

            <div class="field">

                <label asp-for="ContactForm.Message">
                    Cuéntanos de tu proyecto
                </label>

                <textarea asp-for="ContactForm.Message"
                          placeholder="Qué necesitas, plazos aproximados, presupuesto si ya lo tienes...">
                </textarea>

                <span asp-validation-for="ContactForm.Message"
                      style="
                    color:#B3261E;
                    font-family:var(--mono);
                    font-size:12px;
                    ">
                </span>

            </div>


            <!-- BOTÓN -->

            <button type="submit"
                    class="submit-btn">
                Enviar mensaje →
            </button>

        </form>

    </div>

</section>


<!-- ========================================================= -->
<!-- FOOTER -->
<!-- ========================================================= -->

<footer>

    <div class="wrap footer-row">

        <span>
