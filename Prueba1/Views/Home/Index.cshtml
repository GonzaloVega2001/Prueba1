@{
    ViewData["Title"] = "Home Page";
}

<!-- HERO -->
<section class="hero">
    <div class="container text-center">
        <span class="badge-pill">✨ Bienvenido</span>
        <h1 class="hero-title">Construye algo <span>increíble</span></h1>
        <p class="hero-subtitle">
            Aprende a crear aplicaciones web modernas con
            <a href="https://learn.microsoft.com/aspnet/core" target="_blank">ASP.NET Core</a>.
        </p>
        <div class="hero-actions">
            <a href="#features" class="btn btn-primary btn-lg">Empezar ahora</a>
            <a href="https://learn.microsoft.com/aspnet/core" target="_blank" class="btn btn-outline-light btn-lg">Ver documentación</a>
        </div>
    </div>
</section>

<!-- FEATURES -->
<section id="features" class="features py-5">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">⚡</div>
                    <h3>Rápido</h3>
                    <p>Rendimiento optimizado desde el primer request.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">🔒</div>
                    <h3>Seguro</h3>
                    <p>Autenticación y buenas prácticas integradas.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">🚀</div>
                    <h3>Escalable</h3>
                    <p>Listo para crecer junto a tu proyecto.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="cta text-center py-5">
    <div class="container">
        <h2>¿Listo para comenzar?</h2>
        <p>Crea tu primera aplicación en minutos.</p>
        <a href="#" class="btn btn-primary btn-lg">Crear proyecto</a>
    </div>
</section>

<style>
    :root {
        --primary: #6366f1;
        --primary-dark: #4338ca;
        --bg-dark: #0f172a;
        --text-light: #e2e8f0;
    }

    .hero {
        background: linear-gradient(135deg, var(--bg-dark) 0%, #1e1b4b 100%);
        color: white;
        padding: 100px 20px;
        position: relative;
        overflow: hidden;
    }

    .badge-pill {
        display: inline-block;
        background: rgba(99, 102, 241, 0.15);
        color: #a5b4fc;
        padding: 6px 16px;
        border-radius: 999px;
        font-size: 0.9rem;
        margin-bottom: 20px;
        border: 1px solid rgba(99, 102, 241, 0.3);
    }

    .hero-title {
        font-size: 3.2rem;
        font-weight: 800;
        margin-bottom: 20px;
    }

    .hero-title span {
        background: linear-gradient(90deg, #818cf8, #c084fc);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .hero-subtitle {
        font-size: 1.2rem;
        color: #cbd5e1;
        max-width: 600px;
        margin: 0 auto 35px;
    }

    .hero-subtitle a {
        color: #a5b4fc;
        text-decoration: underline;
    }

    .hero-actions {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-primary {
        background: var(--primary);
        border: none;
        padding: 12px 32px;
        border-radius: 10px;
        font-weight: 600;
        transition: 0.2s ease;
    }

    .btn-primary:hover {
        background: var(--primary-dark);
        transform: translateY(-2px);
    }

    .btn-outline-light {
        padding: 12px 32px;
        border-radius: 10px;
        font-weight: 600;
        border: 1px solid rgba(255,255,255,0.3);
    }

    .features {
        background: #f8fafc;
    }

    .feature-card {
        background: white;
        padding: 35px 25px;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        height: 100%;
        transition: 0.2s ease;
    }

    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(99,102,241,0.15);
    }

    .feature-icon {
        font-size: 2.2rem;
        margin-bottom: 15px;
    }

    .feature-card h3 {
        font-weight: 700;
        margin-bottom: 10px;
    }

    .feature-card p {
        color: #64748b;
        margin: 0;
    }

    .cta {
        background: var(--bg-dark);
        color: white;
    }

    .cta h2 {
        font-weight: 800;
        margin-bottom: 10px;
    }

    .cta p {
        color: #94a3b8;
        margin-bottom: 25px;
    }

    @@media (max-width: 768px) {
        .hero-title {
            font-size: 2.2rem;
        }
    }
</style>