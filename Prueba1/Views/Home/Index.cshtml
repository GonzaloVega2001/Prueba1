@model HomeViewModel

@{
    var status = TempData["ContactStatus"] as string;
    var toastMessage = TempData["ContactMessage"] as string;

    if (string.IsNullOrWhiteSpace(toastMessage))
    {
        toastMessage = status == "success"
            ? "Te responderemos apenas lo revisemos — gracias por escribir."
            : status == "error"
                ? "No se pudo enviar el mensaje."
                : null;
    }
}

@if (status is not null)
{
    <div id="toast-data"
         data-status="@status"
         data-message="@toastMessage"
         style="display:none;">
    </div>
}

<header>
    <div class="nav">

        <div class="logo">
            <span class="dot"></span>Commit<span class="logo-sep">;</span><span class="logo-sub">Systems</span>
        </div>

        <nav class="nav-links" id="nav-links">
            <a href="#servicios">Servicios</a>
            <a href="#proceso">Proceso</a>
            <a href="#stack">Stack</a>
            <a href="#contacto">Contacto</a>
        </nav>

        <a href="#contacto" class="nav-cta">
            Agendar llamada
        </a>

        <button class="burger"
                id="burger"
                aria-label="Abrir menú">
            <span></span>
            <span></span>
            <span></span>
        </button>

    </div>
</header>


