<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@(ViewData["Title"] ?? "Commit;Systems — Desarrollador y Consultores de Software en San Felipe")</title>
    <meta name="description" content="Consultora de desarrollo web y de aplicaciones en San Felipe, Valparaíso. Sitios web, apps móviles y consultoría técnica a medida para empresas de la zona." />
    <meta name="keywords" content="desarrollador San Felipe, consultores San Felipe, desarrollo web San Felipe, desarrollo de aplicaciones San Felipe, programador San Felipe, consultoría de software Valparaíso" />
    <link rel="canonical" href="https://commitsystems.cl/" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Commit;Systems — Desarrollador y Consultores de Software en San Felipe" />
    <meta property="og:description" content="Desarrollo web y de aplicaciones a medida, con base en San Felipe, Valparaíso." />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:url" content="https://commitsystems.cl/" />
    <link rel="icon" type="image/png" href="~/favicon.png" />

    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "ProfessionalService",
      "name": "Commit;Systems",
      "description": "Consultora de desarrollo web y de aplicaciones en San Felipe, Valparaíso.",
      "url": "https://commitsystems.cl/",
      "email": "gvega@comsys.cl",
      "areaServed": "San Felipe, Valparaíso, Chile",
      "address": {
        "@@type": "PostalAddress",
        "addressLocality": "San Felipe",
        "addressRegion": "Valparaíso",
        "addressCountry": "CL"
      },
      "serviceType": ["Desarrollo web", "Desarrollo de aplicaciones", "Consultoría técnica de software"]
    }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @RenderBody()

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
